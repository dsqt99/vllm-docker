# ==============================================================================
# vLLM Cluster & Manager Environment Configuration
# ==============================================================================

# Domain Configuration
DOMAIN=vllm.example.com

# Model IDs (HuggingFace ID hoặc đường dẫn model trong cache)
MODEL_ID=Qwen/Qwen3.5-9B

# HuggingFace Token (Bắt buộc nếu tải model private/gated hoặc tránh giới hạn rate limit khi tải online)
HF_TOKEN=hf_your_token_here

# LiteLLM Master API Key
LITELLM_MASTER_KEY=sk-your-secure-master-key-here

# ------------------------------------------------------------------------------
# Cấu hình Offline / Online & Thư mục Trọng số (HuggingFace Cache)
# ------------------------------------------------------------------------------
# Đường dẫn thư mục chứa trọng số trên máy chủ Host (nơi lưu các thư mục models--...)
# Ví dụ: /root/.cache/huggingface hoặc /home/cahy/.cache/huggingface
HF_CACHE_DIR=/root/.cache/huggingface

# Chế độ Air-gapped / Offline:
# 1 = Hoạt động hoàn toàn Offline (Chỉ dùng model đã copy sẵn vào HF_CACHE_DIR, không tải online)
# 0 = Tự động tải model từ HuggingFace nếu máy chủ đích có kết nối Internet
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ------------------------------------------------------------------------------
# Phân bổ GPU cho mô hình LLM chính (TP=2)
# ------------------------------------------------------------------------------
# Có thể dùng số thứ tự GPU index (0, 1) hoặc mã GPU UUID (GPU-uuid...)
GPU_DEVICES=0,1
MAIN_GPU_0=0
MAIN_GPU_1=1

TENSOR_PARALLEL_SIZE=2
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192

# ------------------------------------------------------------------------------
# Cấu hình vLLM Manager Web UI (:8050)
# ------------------------------------------------------------------------------
MANAGER_PORT=8050
VLLM_MANAGER_API_KEY=your_secure_manager_api_key_here

# ------------------------------------------------------------------------------
# Phân bổ GPU cho các dịch vụ phụ (OCR, Embedding, Reranker, Decision)
# ------------------------------------------------------------------------------
AUX_GPU_0=2

# Decision Model Configuration (:8006)
DECISION_MODEL_ID=mssfj/Qwen3.5-9B-GPTQ-INT4
DECISION_PORT=8006
DECISION_GPU_DEVICES=2
DECISION_GPU_MEMORY_UTILIZATION=0.37
DECISION_MAX_MODEL_LEN=8192

# SenOCR-Vi Configuration (:8007)
SENOCR_MODEL_ID=VietAlphaLabs/SenOCR-Vi
SENOCR_PORT=8007
SENOCR_GPU_DEVICES=2
SENOCR_GPU_MEMORY_UTILIZATION=0.25
SENOCR_MAX_MODEL_LEN=4096

# ------------------------------------------------------------------------------
# Cấu hình Monitoring (Prometheus & Grafana)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9095
GRAFANA_PORT=3050
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
