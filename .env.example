# Domain Configuration
DOMAIN=vllm.example.com

# Model IDs (HuggingFace)
MODEL_ID=Qwen/Qwen3.5-9B

# HuggingFace Token (Optional for public models, required for gated models)
HF_TOKEN=hf_your_token_here

# LiteLLM Configuration
LITELLM_MASTER_KEY=sk-your-secure-master-key-here

# GPU Allocation for Main Model (TP=2)
# Specify GPU UUIDs or device indices (e.g., 0,1 or GPU-uuid1,GPU-uuid2)
GPU_DEVICES=0,1

TENSOR_PARALLEL_SIZE=2
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192

# Manager Web UI Configuration
MANAGER_PORT=8050
VLLM_MANAGER_API_KEY=your_secure_manager_api_key_here

# Decision Model Configuration
DECISION_MODEL_ID=Qwen/Qwen3.5-9B
DECISION_PORT=8006
DECISION_GPU_DEVICES=2
DECISION_GPU_MEMORY_UTILIZATION=0.28
DECISION_MAX_MODEL_LEN=8192

# SenOCR-Vi Configuration
SENOCR_MODEL_ID=VietAlphaLabs/SenOCR-Vi
SENOCR_PORT=8007
SENOCR_GPU_DEVICES=GPU-uuid-here
SENOCR_GPU_MEMORY_UTILIZATION=0.15
SENOCR_MAX_MODEL_LEN=8192

# Monitoring Configuration
PROMETHEUS_PORT=9095
GRAFANA_PORT=3050
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin


# Air-gapped: vLLM loads models only from the local HF cache (set 0 to allow downloads)
HF_HUB_OFFLINE=1
