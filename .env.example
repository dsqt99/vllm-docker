# ==============================================================================
# HẠ TẦNG AI SERVING 4x GPU (TỔNG 384GB VRAM HOẶC TÙY CHỌN PHẦN CỨNG)
# ==============================================================================
# Phân bổ tài nguyên thực tế:
# - GPU 0, 1 (TP=2) : Qwen3.8-Flash-Next-FP8 (LLM Hội thoại / Suy luận chính, Context 131K)
# - GPU 2    (TP=1) : Qwen3.6-35B-A3B (Fast LLM - Siêu tốc độ, Phản hồi nhanh, Context 32K)
# - GPU 3    (Shared): Cụm Micro-Services vệ tinh:
#                     + HunyuanOCR (VRAM ~21GB, Context 8192)
#                     + Qwen3-Embedding-4B (VRAM ~17GB, Runner Pooling, Context 16K)
#                     + Qwen3-Reranker-4B (VRAM ~17GB, Runner Pooling / Score, Context 8K)
# - Gateway:          LiteLLM Gateway (Port 4000) gom toàn bộ endpoint API
# - Mission Control:  vLLM Manager Web UI (Port 8050)
# - Giám sát Cluster: Prometheus (Port 9095) & Grafana (Port 3050)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ THỐNG CHUNG & CHẾ ĐỘ MẠNG
# ------------------------------------------------------------------------------
DOMAIN=vllm.example.com
HF_TOKEN=hf_your_token_here

# Thư mục cache trọng số HuggingFace trên máy chủ Host (nơi chứa models--...)
# Ví dụ: /root/.cache/huggingface hoặc /data/models/.cache/huggingface
HF_CACHE_DIR=/root/.cache/huggingface

# Chế độ Offline / Air-Gapped:
# 1 = Mạng nội bộ cách ly (Chỉ dùng model đã copy sẵn vào cache, cấm ra Internet)
# 0 = Tự động tải model từ HuggingFace nếu máy chủ có Internet
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ------------------------------------------------------------------------------
# 2. MODEL 1: Qwen3.8-Flash-Next-FP8 (LLM Suy luận chính)
# Container: ai_flash_next | Port: 8000 | Route LiteLLM: qwen3.8-flash-next-fp8
# Phân bổ: GPU 0, 1 | TP=2 | Context 131K | FP8 KV-Cache | MTP Speculative
# ------------------------------------------------------------------------------
FLASH_NEXT_MODEL_ID=Qwen/Qwen3.8-Flash-Next-FP8
FLASH_NEXT_PORT=8000
FLASH_NEXT_GPU_DEVICES=0,1
FLASH_NEXT_TP_SIZE=2
FLASH_NEXT_GPU_MEMORY_UTILIZATION=0.92
FLASH_NEXT_MAX_MODEL_LEN=131072
FLASH_NEXT_MAX_NUM_SEQS=8

# ------------------------------------------------------------------------------
# 3. MODEL 2: Qwen3.6-35B-A3B (Fast LLM - Siêu tốc độ)
# Container: ai_fast_llm | Port: 8001 | Route LiteLLM: qwen3.6-35b-a3b, fast-model
# Phân bổ: GPU 2 | TP=1 | Active 3B MoE | Context 32K
# ------------------------------------------------------------------------------
FAST_LLM_MODEL_ID=Qwen/Qwen3.6-35B-A3B
FAST_LLM_PORT=8001
FAST_LLM_GPU_DEVICES=2
FAST_LLM_TP_SIZE=1
FAST_LLM_GPU_MEMORY_UTILIZATION=0.88
FAST_LLM_MAX_MODEL_LEN=32768
FAST_LLM_MAX_NUM_SEQS=8

# ------------------------------------------------------------------------------
# 4. MODEL 3: HunyuanOCR (Bóc tách OCR tài liệu, bảng biểu đa phương thức)
# Container: ai_hunyuan_ocr | Port: 8002 | Route LiteLLM: hunyuan-ocr
# Phân bổ: GPU 3 | VRAM ~21GB | Context 8K | Enforce Eager
# ------------------------------------------------------------------------------
OCR_MODEL_ID=tencent/HunyuanOCR
OCR_PORT=8002
OCR_GPU_DEVICES=3
OCR_GPU_MEMORY_UTILIZATION=0.25
OCR_MAX_MODEL_LEN=8192

# ------------------------------------------------------------------------------
# 5. MODEL 4: Qwen3-Embedding-4B (Vector Embedding ngữ nghĩa)
# Container: ai_embedding | Port: 8003 | Route LiteLLM: qwen3-embedding-4b
# Phân bổ: GPU 3 | VRAM ~17GB | Runner Pooling | Context 16K
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-4B
EMBEDDING_PORT=8003
EMBEDDING_GPU_DEVICES=3
EMBEDDING_GPU_MEMORY_UTILIZATION=0.20
EMBEDDING_MAX_MODEL_LEN=16384

# ------------------------------------------------------------------------------
# 6. MODEL 5: Qwen3-Reranker-4B (Tái xếp hạng kết quả tìm kiếm RAG)
# Container: ai_reranker | Port: 8004 | Route LiteLLM: qwen3-reranker-4b
# Phân bổ: GPU 3 | VRAM ~17GB | Runner Pooling / Score | Context 8K
# ------------------------------------------------------------------------------
RERANKER_MODEL_ID=Qwen/Qwen3-Reranker-4B
RERANKER_PORT=8004
RERANKER_GPU_DEVICES=3
RERANKER_GPU_MEMORY_UTILIZATION=0.20
RERANKER_MAX_MODEL_LEN=8192

# ------------------------------------------------------------------------------
# 7. MODEL 6 (Tùy chọn): Decision Router Model (Phân loại ý định / Rẽ nhánh)
# Container: decision-qwen | Port: 8006 | Route LiteLLM: decision-qwen
# Phân bổ: GPU 3 | Quantized INT4 | VRAM ~9GB | Context 8K
# ------------------------------------------------------------------------------
DECISION_MODEL_ID=mssfj/Qwen3.5-9B-GPTQ-INT4
DECISION_PORT=8006
DECISION_GPU_DEVICES=3
DECISION_GPU_MEMORY_UTILIZATION=0.15
DECISION_MAX_MODEL_LEN=8192

# ------------------------------------------------------------------------------
# 8. LITELLM GATEWAY & MISSION CONTROL MANAGER
# ------------------------------------------------------------------------------
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-your-secure-master-key-here

MANAGER_PORT=8050
VLLM_MANAGER_API_KEY=your_secure_manager_api_key_here

# ------------------------------------------------------------------------------
# 9. GIÁM SÁT MONITORING (Prometheus & Grafana)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9095
GRAFANA_PORT=3050
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
